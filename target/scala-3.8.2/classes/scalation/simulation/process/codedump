# 🛣️ 6. LANE CENTERLINES (PROPER OFFSET)

```scala
def drawLanes(g2: Graphics2D, road: RoadSurface): Unit =
    val curve   = buildSpline(road.control, 12)
    val normals = computeNormals(curve)

    val laneWidth = road.width / road.lanes

    g2.setColor(Color.WHITE)
    g2.setStroke(new BasicStroke(1.5f))

    for lane <- 1 until road.lanes do
        val offset = (lane - road.lanes / 2.0) * laneWidth

        for i <- 0 until curve.length - 1 do
            val p1 = curve(i)
            val p2 = curve(i+1)

            val (nx1, ny1) = normals(i)
            val (nx2, ny2) = normals(i+1)

            val a = Point(p1.x + nx1 * offset, p1.y + ny1 * offset)
            val b = Point(p2.x + nx2 * offset, p2.y + ny2 * offset)

            g2.drawLine(a.x.toInt, a.y.toInt, b.x.toInt, b.y.toInt)
```

