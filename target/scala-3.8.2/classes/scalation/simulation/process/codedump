# 🧱 4. BUILD ROAD MESH (NOT JUST POLYGON — TRUE SURFACE)

```scala
import java.awt.Polygon

def buildRoadPolygon(curve: Vector[Point], normals: Vector[(Double,Double)], width: Double): Polygon =
    val left  = scala.collection.mutable.ArrayBuffer[Point]()
    val right = scala.collection.mutable.ArrayBuffer[Point]()

    for i <- curve.indices do
        val p = curve(i)
        val (nx, ny) = normals(i)

        left  += Point(p.x + nx * width/2, p.y + ny * width/2)
        right += Point(p.x - nx * width/2, p.y - ny * width/2)

    val poly = new Polygon()
    left.foreach(p => poly.addPoint(p.x.toInt, p.y.toInt))
    right.reverse.foreach(p => poly.addPoint(p.x.toInt, p.y.toInt))

    poly
```

