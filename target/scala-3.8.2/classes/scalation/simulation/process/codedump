def drawRoad(g2: Graphics2D, road: RoadSurface): Unit =
    val curve   = buildSpline(road.control, 12)
    val normals = computeNormals(curve)

    val poly = buildRoadPolygon(curve, normals, road.width)

    g2.setColor(new Color(110,100,85))   // asphalt
    g2.fillPolygon(poly)
```

